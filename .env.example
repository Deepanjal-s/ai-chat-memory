# ---- Storage --------------------------------------------------------------
# Where raw exports, the embedded database, documents, logs and backups live.
# Keep this OUTSIDE any cloud-synced folder (OneDrive/Dropbox): it holds confidential data.
DATA_DIR=./data

# Leave empty to use the embedded database (PGlite) inside DATA_DIR.
# Set to a PostgreSQL URL (with the pgvector extension) for server deployments.
DATABASE_URL=

# Daily database snapshots (embedded database only) and how many to keep.
BACKUP_DIR=
BACKUP_KEEP=7

# ---- Access ---------------------------------------------------------------
# Generate with:  npm run hash-password -- "your password"
APP_PASSWORD_HASH=
# Long random string used to sign login sessions (at least 32 characters).
SESSION_SECRET=
SESSION_TTL_HOURS=12

# ---- Automatic import of official ChatGPT exports --------------------------
# The app watches this folder (default: your Downloads folder) and imports new ChatGPT export ZIPs.
WATCH_ENABLED=true
WATCH_DIR=
WATCH_INTERVAL_SECONDS=30
WATCH_SOURCE_LABEL=ChatGPT
# Dashboard reminder when the last export is older than this.
EXPORT_REMINDER_DAYS=30

# ---- AI (optional) ---------------------------------------------------------
# none      = everything stays on this server: rule-based extraction, answers show verified records only.
# gemini    = Google Gemini extracts knowledge, answers questions and writes document overviews.
# anthropic = Claude does the same.
# With either provider, conversation excerpts are sent to it; every call is logged on the Status page.
# Gemini free tier: Google may use submitted content to improve its products; enable billing for confidential data.
AI_PROVIDER=none
# Default model: gemini-3.5-flash (gemini) or claude-opus-5-5 (anthropic).
AI_MODEL=
GEMINI_API_KEY=
ANTHROPIC_API_KEY=

# ---- Semantic search (optional) -------------------------------------------
# none   = keyword search only
# local  = bge-small-en-v1.5 on this computer (free, nothing leaves the machine;
#          needs the optional package @huggingface/transformers, model ~35 MB downloaded once)
# voyage = Voyage AI embeddings (sends message text to Voyage AI)
# EMBEDDING_MODEL / EMBEDDING_DIM default to the provider's model: bge-small (384) or voyage-3.5 (1024).
# The dimension is fixed when the database is created; changing provider later needs a fresh DATA_DIR.
EMBEDDING_PROVIDER=none
EMBEDDING_MODEL=
EMBEDDING_DIM=
VOYAGE_API_KEY=

# ---- PDF fonts (optional) ---------------------------------------------------
# A Unicode TrueType font for PDFs (Arial on Windows / DejaVu in Docker are found automatically).
PDF_FONT=
PDF_FONT_BOLD=
